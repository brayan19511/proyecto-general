# Cabeceras de seguridad. Se incluyen en cada location porque un add_header
# dentro de una location anula los del server (regla de nginx).
#
# CSP: solo scripts, estilos, fuentes e imágenes propios; las llamadas HTTP solo
# a este origen y a la central (${API_ORIGIN}). data: en imágenes por los iconos
# SVG que Bootstrap incrusta en su CSS. Sin inline scripts ni eval.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Frame-Options "DENY" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
