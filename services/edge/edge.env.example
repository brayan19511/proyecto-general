# Secretos del proxy de borde para el modo CADDY_TLS=dns. Copiar a .env (ignorado
# por git). En modo "internal" no hace falta nada de esto.

# Correo para avisos de Let's Encrypt (vencimientos, problemas con el certificado).
ACME_EMAIL=
# Token de la API de Cloudflare con permiso "Zone > DNS > Edit" solo para la zona
# del dominio (Mi perfil > API Tokens > Create Token > "Edit zone DNS").
CLOUDFLARE_API_TOKEN=
