# Nombre mostrado en /docs. Vacío = default de config.py.
PROJECT_NAME=

# Identificación del servicio en los logs (schema audit).
SERVICE_NAME=sap-operaciones
SERVICE_VERSION=0.1.0
# Logs de cada solicitud (paquete platform_audit). false los apaga.
AUDIT_ENABLED=true
# Máximo de body guardado por solicitud, en bytes (bodies más grandes: solo tamaño).
AUDIT_MAX_BODY_BYTES=4096

# Base propia (schema sap_operaciones). Vacío = default (postgresql, localhost, 5432).
# En el Compose, DB_HOST/DB_PORT los fija docker-compose.yml.
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
# Obligatorios.
DB_NAME=
DB_USER=
DB_PASSWORD=

# Orígenes web permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:3000"]

# Proxies propios (API central): IPs o rangos CIDR, lista JSON. Vacío = conexión directa.
TRUSTED_PROXIES=[]

# Auth (validación de identidad y permisos). URL interna SIN /auth. Obligatoria.
# Local: http://127.0.0.1:8001 (la central); en el Compose la fija docker-compose.yml.
AUTH_URL=http://127.0.0.1:8001
# Espera máxima por llamada a auth (s). Vacío = 30.
AUTH_TIMEOUT_SECONDS=

# SAP Business One Service Layer (p. ej. https://sap-host:50000/b1s/v1).
# Vacío = no se pueden ejecutar trabajos (el servicio arranca igual).
SAP_SERVICE_LAYER_URL=
# Verificar el certificado TLS del Service Layer. false solo como decisión
# explícita (certificado autofirmado sin CA instalable).
SAP_VERIFY_TLS=true
# CA propia (.pem) para un certificado interno. Vacío = las CA del sistema.
SAP_CA_FILE=
# Esperas (s) para conectar y por cada llamada. Sin reintentos automáticos.
SAP_CONNECT_TIMEOUT_SECONDS=10
SAP_REQUEST_TIMEOUT_SECONDS=120
# Usuario SAP para buscar documentos y descargar anexos (/documents). Uno solo
# por ahora; conviene un usuario de solo lectura. Vacío = /documents responde 409.
SAP_DOCUMENTS_USER=
SAP_DOCUMENTS_PASSWORD=
# Carpeta de anexos de SAP montada en solo lectura en el contenedor (ver
# desarrollo/plataforma-completa/compose.anexos.yml). Vacío = descargar por el
# Service Layer (requiere la carpeta montada en el servidor de SAP).
SAP_ATTACHMENTS_DIR=

# Claves Fernet (lista JSON) para cifrar las claves SAP guardadas. Obligatoria.
# Generar una: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotación: agregar la nueva al inicio; la vieja sigue descifrando hasta retirarla.
CREDENTIALS_ENCRYPTION_KEYS=[]

# Desfase horario (horas) de las fechas en las descargas CSV; Perú = -5 (sin horario de verano).
EXPORT_UTC_OFFSET_HOURS=-5

# Máximo de ítems (documentos o conciliaciones) por trabajo.
JOB_MAX_ITEMS=50000
# Worker: cada cuántos segundos busca trabajos y cuánto dura su bloqueo sobre uno (s).
WORKER_POLL_SECONDS=5
WORKER_LOCK_SECONDS=300
