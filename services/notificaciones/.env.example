# Nombre mostrado en /docs. Vacío = default de config.py.
PROJECT_NAME=

# Identificación del servicio en los logs (schema audit).
SERVICE_NAME=notificaciones
SERVICE_VERSION=0.1.0
# Logs de cada solicitud (paquete platform_audit). false los apaga.
AUDIT_ENABLED=true
# Máximo de body guardado por solicitud, en bytes (bodies más grandes: solo tamaño).
AUDIT_MAX_BODY_BYTES=4096

# Conexión a la base. Vacío = default (postgresql, localhost, 5432).
# Desde Docker: host.docker.internal (base en tu PC), db (mismo Compose) o el host de la nube.
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
# Obligatorios.
DB_NAME=
DB_USER=
DB_PASSWORD=

# Orígenes web permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:3000"]

# Proxies propios (API central, balanceador): IPs exactas o rangos CIDR, lista JSON.
# Solo desde ellas se confía en X-Forwarded-For y X-Trace-Id. Vacío = conexión directa.
TRUSTED_PROXIES=[]

# Claves para cifrar las contraseñas SMTP guardadas en la base (lista JSON). Obligatoria.
# Se cifra con la primera y se descifra con cualquiera (para rotar: agregar la nueva al inicio).
# Es un secreto: no versionarla. Si se pierden todas, hay que volver a ingresar las contraseñas.
# Generar una: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEYS=[]

# Auth: valida token, empresa (X-Company-Id) y permisos de cada solicitud. Obligatoria.
# Sin la ruta /auth. Desde Windows: http://127.0.0.1:<puerto de la central o de auth>; en el Compose: http://auth:8000.
AUTH_URL=http://127.0.0.1:8001
# Espera máxima por llamada a auth, en segundos (sin reintentos). Vacío = 30.
AUTH_TIMEOUT_SECONDS=

# Conexiones SMTP salientes (protección contra SSRF y TLS). Las define quien despliega.
# Puertos que una cuenta puede usar (lista JSON). Vacío = [25, 465, 587, 2525].
SMTP_ALLOWED_PORTS=
# Redes internas permitidas como destino (CIDR, lista JSON), p. ej. un relay propio:
# ["192.168.30.199/32"]. Vacío = solo direcciones públicas.
SMTP_ALLOWED_PRIVATE_NETWORKS=[]
# CA interna adicional (archivo PEM) para relays con certificado propio. Vacío = solo CA públicas.
SMTP_CA_BUNDLE=
# Hosts con TLS SIN verificar certificado (lista JSON, tal como se guardan en la cuenta).
# Cifra pero no impide suplantar al servidor: último recurso para relays internos. Vacío = verificar siempre.
SMTP_TLS_UNVERIFIED_HOSTS=[]

# Tamaño máximo de un mensaje MIME completo (cuerpo + adjuntos codificados), en bytes.
# Vacío = 26214400 (25 MB). Un mensaje mayor se rechaza al crear el envío (422 message_too_large).
MESSAGE_MAX_BYTES=

# Worker de envío (python -m app.worker). Vacío = default.
# Segundos entre búsquedas cuando no hay pendientes (5).
WORKER_POLL_SECONDS=
# Bloqueo de un mensaje tomado, en segundos (600). Si vence en "sending", el mensaje pasa a "uncertain".
WORKER_LOCK_SECONDS=
# Espera antes de cada reintento automático (lista JSON, segundos). Su largo = cantidad de reintentos.
# Vacío = [60, 300, 900]: 3 reintentos de 1, 5 y 15 minutos (acuerdo).
RETRY_DELAYS_SECONDS=

# Retención (la ejecuta el worker). Plazos desde el último intento de un mensaje fallido o incierto.
# Aviso por correo al solicitante (48) y cancelación con purga de adjuntos (72), en horas. Vacío = default.
RETENTION_NOTICE_AFTER_HOURS=
RETENTION_CANCEL_AFTER_HOURS=
# Cada cuántos segundos se revisan los plazos (600).
RETENTION_INTERVAL_SECONDS=
# Zona horaria de las fechas del aviso. Vacío = America/Lima.
NOTICE_TIMEZONE=
# Enlace opcional "Revisar el envío" en el aviso; {dispatch_id} se reemplaza por el id.
# Sin pantalla en el front todavía: dejar comentado. Ejemplo:
# NOTICE_LINK_TEMPLATE=https://plataforma.example/notificaciones/envios/{dispatch_id}

# Carga inicial (POST /notificaciones/admin/seed, solo administrador de plataforma).
# true solo para ejecutarla; luego false. Vacío = false.
SEED_ENABLED=
