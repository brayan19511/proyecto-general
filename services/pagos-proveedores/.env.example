# Nombre mostrado en /docs. Vacío = default de config.py.
PROJECT_NAME=

# Identificación del servicio en los logs (schema audit).
SERVICE_NAME=pagos-proveedores
SERVICE_VERSION=0.1.0
# Logs de cada solicitud (paquete platform_audit). false los apaga.
AUDIT_ENABLED=true
# Máximo de body guardado por solicitud, en bytes (bodies más grandes: solo tamaño).
AUDIT_MAX_BODY_BYTES=4096

# Conexión a la base. Vacío = default (postgresql, localhost, 5432).
# Desde Docker: host.docker.internal (base en tu PC), db (mismo Compose) o el host de la nube.
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
# Obligatorios.
DB_NAME=
DB_USER=
DB_PASSWORD=

# Orígenes web permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:3000"]

# Proxies propios (API central, balanceador): IPs exactas o rangos CIDR, lista JSON.
# Solo desde ellas se confía en X-Forwarded-For y X-Trace-Id. Vacío = conexión directa.
TRUSTED_PROXIES=[]

# Auth: valida token, empresa (X-Company-Id) y permisos de cada solicitud. Obligatoria.
# Sin la ruta /auth. Desde Windows: http://127.0.0.1:<puerto de la central>; en el Compose: http://auth.internal:8000.
AUTH_URL=http://127.0.0.1:8001
# Espera máxima por llamada a auth, en segundos (sin reintentos). Vacío = 30.
AUTH_TIMEOUT_SECONDS=

# Lector de constancias. OCR para PDFs escaneados (necesita tesseract con el idioma y poppler;
# la imagen de Docker los trae). false = solo PDFs con texto. Vacío = default.
OCR_ENABLED=
# Idioma de tesseract (spa).
OCR_LANG=
# Resolución al convertir la página a imagen para OCR (250).
OCR_DPI=
# Mínimo de caracteres de texto para no aplicar OCR (80).
OCR_MIN_TEXT_LENGTH=

# Notificaciones: crea los envíos de los lotes con el token del usuario. Obligatoria.
# Sin la ruta /notificaciones. Local: http://127.0.0.1:8010; en el Compose: http://notificaciones.internal:8000.
NOTIFICACIONES_URL=http://127.0.0.1:8010
# Espera por llamada, en segundos (120): sube los PDFs y notificaciones arma los mensajes antes de responder.
NOTIFICACIONES_TIMEOUT_SECONDS=
# Plantilla por defecto al enviar un lote. Vacío = payment_provider_summary.
DEFAULT_TEMPLATE_CODE=
