# Nombre mostrado en /docs. Vacío = default de config.py.
PROJECT_NAME=

# Identificación del servicio en los logs (schema audit).
SERVICE_NAME=canales-venta
SERVICE_VERSION=0.1.0
# Logs de cada solicitud (paquete platform_audit). false los apaga.
AUDIT_ENABLED=true
# Máximo de body guardado por solicitud, en bytes (bodies más grandes: solo tamaño).
AUDIT_MAX_BODY_BYTES=4096

# Conexión a la base. Vacío = default (postgresql, localhost, 5432).
# Desde Docker: host.docker.internal (base en tu PC), db (mismo Compose) o el host de la nube.
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
# Obligatorios.
DB_NAME=db_tdip
DB_USER=admin
DB_PASSWORD="admin1951"
# Orígenes web permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:3000"]

# Proxies propios (API central, balanceador): IPs exactas o rangos CIDR, lista JSON.
# Solo desde ellas se confía en X-Forwarded-For y X-Trace-Id. Vacío = conexión directa.
TRUSTED_PROXIES=[]

# Ofisis (SQL Server externo, base EcommDB): tablas de SKU de lastmiller.
# Vacío = sin Ofisis: el servicio arranca, pero lastmiller no funciona.
OFISIS_HOST=
OFISIS_PORT=1433
OFISIS_USER=
OFISIS_PASSWORD=
OFISIS_DATABASE=EcommDB
# Driver ODBC instalado (Docker: 18; en Windows puede ser 17).
OFISIS_DRIVER=ODBC Driver 18 for SQL Server
# Cifrado y validación de certificado. Desactivar solo si el servidor no los admite.
OFISIS_ENCRYPT=true
OFISIS_TRUST_SERVER_CERTIFICATE=true
# Límites: login (s), consulta (s) y espera por bloqueos de otros procesos (ms).
OFISIS_CONNECT_TIMEOUT_SECONDS=10
OFISIS_QUERY_TIMEOUT_SECONDS=30
OFISIS_LOCK_TIMEOUT_MS=5000

# Auth (validación de identidad y permisos). URL interna SIN /auth.
# Ej.: http://127.0.0.1:8001 en local; http://auth:8000 en el Compose.
AUTH_URL=
# Espera máxima por llamada a auth (s). Vacío = 30.
AUTH_TIMEOUT_SECONDS=

# Código en auth de la empresa dueña de lastmiller (p. ej. RASH).
# Vacío = lastmiller deshabilitado (409). Otras empresas reciben 404.
LASTMILLER_COMPANY_CODE=
# Filas por transacción al escribir en Ofisis en las cargas masivas (1-1000). Vacío = 200.
LASTMILLER_WRITE_BATCH_SIZE=
