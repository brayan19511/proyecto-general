# Un solo archivo para dos usos: el Compose de desarrollo completo
# (desarrollo/plataforma-completa, con --env-file ../../services/apigateway/.env)
# y la aplicación de la central (config.py lo lee). Las variables
# DB_USER, DB_PASSWORD, DB_NAME y DB_PORT sirven a ambos.

# --- Compose: PostgreSQL y pgAdmin locales ---
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
# PGADMIN_PORT ya no se usa: pgAdmin se publica por caddy (EDGE_PGADMIN_PORT).

# --- Aplicación: API central ---
# Nombre mostrado en /docs. Vacío = "API central".
PROJECT_NAME=
# Identificación en los logs (schema audit).
SERVICE_NAME=apigateway
SERVICE_VERSION=0.1.0
# Logs de cada solicitud (paquete platform_audit). false los apaga.
AUDIT_ENABLED=true
# Máximo de body guardado por solicitud, en bytes (bodies más grandes: solo tamaño).
AUDIT_MAX_BODY_BYTES=4096

# Base donde se escriben los logs (schema audit). Vacío = postgresql / localhost.
# Desde Docker: host.docker.internal (base en tu PC), db (mismo Compose) o el host de la nube.
DB_ENGINE=postgresql
DB_HOST=localhost

# Orígenes web permitidos por CORS (lista JSON). La central es la entrada del cliente web.
CORS_ORIGINS=["http://localhost:3000"]

# Proxies delante de la central (Nginx, balanceador): IPs exactas o rangos CIDR, lista JSON.
# Solo desde ellas se confía en X-Forwarded-For y X-Trace-Id. Vacío = clientes directos.
TRUSTED_PROXIES=[]

# Auth habilitado en la central. false = /auth/* responde 503 sin llegar a auth
# (auth sigue corriendo). Aplicar: reiniciar solo la central
# (docker compose restart apigateway).
AUTH_ENABLED=true
# Auth: dirección INTERNA que usa la central (obligatoria si AUTH_ENABLED=true). Local: auth en el
# puerto 8000 (la central en el 8001). Mismo Compose: http://auth:8000.
AUTH_URL=http://127.0.0.1:8000
# Espera máxima por llamada a auth, en segundos. Sin reintentos (504 al agotarse).
AUTH_TIMEOUT_SECONDS=30

# Libro mayor / gastos. false (default) = /libro-mayor/* responde 503 sin llegar al
# servicio. También se puede apagar desde el panel sin reiniciar.
LIBRO_MAYOR_ENABLED=false
# Dirección INTERNA de libro-mayor (obligatoria si LIBRO_MAYOR_ENABLED=true). Local:
# libro-mayor en el puerto 8002. En el Compose la fija docker-compose.yml.
LIBRO_MAYOR_URL=http://127.0.0.1:8002
# Espera por defecto de sus rutas, en segundos. /libro-mayor/live-queries tiene
# la suya (130 s) en app/core/public_routes.py.
LIBRO_MAYOR_TIMEOUT_SECONDS=30

# Notificaciones. false (default) = /notificaciones/* responde 503 sin llegar al
# servicio. También se puede apagar desde el panel sin reiniciar.
NOTIFICACIONES_ENABLED=false
# Dirección INTERNA de notificaciones (obligatoria si NOTIFICACIONES_ENABLED=true).
# Local: puerto 8010. En el Compose la fija docker-compose.yml.
NOTIFICACIONES_URL=http://127.0.0.1:8010
# Espera por defecto de sus rutas, en segundos. POST /notificaciones/dispatches
# tiene la suya (120 s) en app/core/public_routes.py.
NOTIFICACIONES_TIMEOUT_SECONDS=30

# Pagos a proveedores. false (default) = /pagos-proveedores/* responde 503 sin llegar
# al servicio. También se puede apagar desde el panel sin reiniciar.
PAGOS_PROVEEDORES_ENABLED=false
# Dirección INTERNA (obligatoria si PAGOS_PROVEEDORES_ENABLED=true). Local: puerto 8012.
# En el Compose la fija docker-compose.yml.
PAGOS_PROVEEDORES_URL=http://127.0.0.1:8012
# Espera por defecto de sus rutas, en segundos. POST /pagos-proveedores/batches (crear y
# enviar lotes) tiene la suya (300 s) en app/core/public_routes.py.
PAGOS_PROVEEDORES_TIMEOUT_SECONDS=30

# --- Compose: puertos e imágenes de las aplicaciones ---
# Puerto de la central en 127.0.0.1 (auth no se publica).
GATEWAY_PORT=8001
# Versiones fijas de imagen. Vacío = auth:0.1.0 / apigateway:0.1.0 / libro-mayor:0.1.0 /
# notificaciones:0.1.0 / pagos-proveedores:0.1.0.
AUTH_IMAGE=
APIGATEWAY_IMAGE=
LIBRO_MAYOR_IMAGE=
NOTIFICACIONES_IMAGE=
PAGOS_PROVEEDORES_IMAGE=

# Cada cuántos segundos la central relee el estado de los servicios
# (gateway.service_states). Un cambio desde la administración aplica en <= este tiempo.
GATEWAY_STATE_TTL_SECONDS=5

# Lista negra de IPs (gateway.ip_blocks). false = no se aplica ningún bloqueo:
# recuperación si un bloqueo deja fuera a quien no debía. Aplicar reiniciando la central.
IP_BLOCKS_ENABLED=true

# --- Front (front-central) ---
# URL de la API vista desde el navegador. "/" = mismo origen (vía caddy). Se fija
# al construir la imagen: cambiarla exige `docker compose build front-central`.
FRONT_API_URL=/
# Origen extra de la API para la CSP del front; 'self' si es el mismo origen.
FRONT_CSP_API_ORIGIN="'self'"  # con las comillas simples dentro de las dobles

# --- Proxy de borde (caddy) y acceso desde la red ---
# Dónde escucha cada puerto publicado: 127.0.0.1 = solo esta máquina;
# 0.0.0.0 = toda la red (o la IP de una interfaz concreta).
EDGE_BIND=127.0.0.1        # caddy. 0.0.0.0 para entrar desde otros equipos de la red
GATEWAY_BIND=127.0.0.1     # la central directa (solo desarrollo con npm run dev)
DB_BIND=127.0.0.1          # la base: dejar en 127.0.0.1 (entrar por pgAdmin o túnel SSH)
EDGE_HTTP_PORT=80          # redirige a HTTPS
EDGE_HTTPS_PORT=443
EDGE_PGADMIN_PORT=8443     # pgAdmin: https://SITE_ADDRESS:8443
# Nombre con que se entra a la plataforma (debe coincidir con la URL del navegador).
# Con CADDY_TLS=dns, el dominio propio (p. ej. plataforma.rashperu.com).
SITE_ADDRESS=localhost
# Modo del proxy de borde (ver services/edge/README.md):
#   http      red local sin dominio: http://<IP de esta PC>/ (sin cifrado; nada que instalar)
#   internal  HTTPS con la CA propia de Caddy (solo esta máquina)
#   dns       dominio propio + Let's Encrypt por DNS (completar services/edge/.env)
CADDY_TLS=http
