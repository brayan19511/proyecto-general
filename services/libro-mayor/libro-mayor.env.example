# Nombre mostrado en /docs. Vacío = default de config.py.
PROJECT_NAME=

# Identificación del servicio en los logs (schema audit).
SERVICE_NAME=libro-mayor
SERVICE_VERSION=0.1.0
# Logs de cada solicitud (paquete platform_audit). false los apaga.
AUDIT_ENABLED=true
# Máximo de body guardado por solicitud, en bytes (bodies más grandes: solo tamaño).
AUDIT_MAX_BODY_BYTES=4096

# Conexión a la base. Vacío = default (postgresql, localhost, 5432).
# Desde Docker: host.docker.internal (base en tu PC), db (mismo Compose) o el host de la nube.
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
# Obligatorios.
DB_NAME=
DB_USER=
DB_PASSWORD=

# Orígenes web permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:3000"]

# Auth: valida token, empresa (X-Company-Id) y permisos de cada solicitud. Obligatoria.
# Solo host y puerto, SIN /auth (el servicio agrega /auth/me): p. ej. http://127.0.0.1:8001
# desde Windows, o http://auth:8000 dentro del Compose.
AUTH_URL=
# Espera máxima por llamada a auth, en segundos (sin reintentos). Vacío = 30.
AUTH_TIMEOUT_SECONDS=

# SAP HANA, solo lectura. Vacío SAP_HOST = SAP deshabilitado (el servicio arranca igual).
# El schema (SBO_...) y la vista de cada empresa se configuran en /admin/sap-company.
SAP_HOST=
SAP_PORT=30015
# Usuario con SELECT sobre las vistas y nada más. Obligatorios si hay SAP_HOST.
SAP_USER=
SAP_PASSWORD=
# TLS. Si el servidor HANA no lo admite: SAP_ENCRYPT=false (tráfico sin cifrar).
SAP_ENCRYPT=false
SAP_VALIDATE_CERTIFICATE=true
# Segundos: abrir conexión / máximo por consulta.
SAP_CONNECT_TIMEOUT_SECONDS=30
SAP_QUERY_TIMEOUT_SECONDS=300

# Sincronización (worker: python -m app.worker). Vacío = default.
# Máximo de días por ejecución manual (366).
SYNC_MAX_DAYS=
# Segundos entre búsquedas de ejecuciones pendientes (10).
SYNC_POLL_SECONDS=
# Minutos sin avance para dar por interrumpida una ejecución (30).
SYNC_STALE_MINUTES=

# Reintentos si SAP o la red fallan al sincronizar (2) y espera inicial en s (30; luego x4).
SYNC_RETRIES=
SYNC_RETRY_SECONDS=

# Reclasificación: líneas por lote (2000). Vacío = default.
CLASSIFY_BATCH_SIZE=
# Consultas en vivo (responden en la misma solicitud). Vacío = default.
# Máximo de días (366) y de cuentas (20) por consulta.
LIVE_QUERY_MAX_DAYS=
LIVE_QUERY_MAX_ACCOUNTS=
# Consultas a SAP a la vez en este proceso, entre todas las solicitudes (4).
LIVE_QUERY_PARALLEL=
# Máximo de líneas con detalle (100000); el resumen no tiene límite.
LIVE_QUERY_MAX_LINES=
# Segundos máximos por consulta (120). Subir también el timeout de la central.
LIVE_QUERY_TIMEOUT_SECONDS=

# Horario del worker: horas HH:MM en SAP_TIMEZONE, separadas por coma.
# off = sin horario (solo ejecuciones manuales). Por confirmar con el usuario.
SYNC_SCHEDULE=06:00,10:00,14:00,18:00
# Zona horaria del servidor SAP (sus fechas vienen sin zona). Por confirmar.
SAP_TIMEZONE=America/Lima

# Carga inicial (POST /libro-mayor/admin/seed). true solo para ejecutarla; luego false.
SEED_ENABLED=false

# Proxies propios (API central, balanceador): IPs exactas o rangos CIDR, lista JSON.
# Solo desde ellas se confía en X-Forwarded-For y X-Trace-Id. Vacío = conexión directa.
TRUSTED_PROXIES=[]
