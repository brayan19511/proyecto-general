# Nombre mostrado en /docs. Opcional; por defecto se utiliza Auth.
PROJECT_NAME=

# Identificación del servicio en los logs (schema audit).
SERVICE_NAME=auth
SERVICE_VERSION=0.1.0
# Logs de cada solicitud (paquete platform_audit). false los apaga.
AUDIT_ENABLED=true
# Máximo de body guardado por solicitud, en bytes (bodies más grandes: solo tamaño).
AUDIT_MAX_BODY_BYTES=4096

# Conexión a la base. Vacío = default (postgresql, localhost, 5432).
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
# Obligatorios.
DB_NAME=
DB_USER=
DB_PASSWORD=

# Orígenes web permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:3000"]

# JWT RS256. Rutas a las claves; vacío = secrets/jwt_private.pem y secrets/jwt_public.pem.
# Generar una vez con: python scripts/generate_jwt_keys.py
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
# Claim iss: quién emite el token.
JWT_ISSUER=auth
# Claim aud: para quién es el token; cada consumidor rechaza tokens de otra audiencia.
JWT_AUDIENCE=platform
# Vida del access token (1-60).
ACCESS_TOKEN_MINUTES=15

# Duración absoluta de la sesión desde el login (1-24).
SESSION_HOURS=5
# Máximo de sesiones simultáneas cuando el usuario no tiene un límite propio.
MAX_SESSIONS=3

# Bloqueo de login por email + IP: tras LOGIN_MAX_FAILURES fallos dentro de
# LOGIN_WINDOW_MINUTES, se bloquea durante LOGIN_BLOCK_MINUTES (responde 429).
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15

# Límites de volumen por IP (todas las solicitudes). 429 + Retry-After al excederlos.
REGISTER_IP_LIMIT=10
REGISTER_IP_WINDOW_MINUTES=60
LOGIN_IP_LIMIT=30
LOGIN_IP_WINDOW_MINUTES=15
REFRESH_IP_LIMIT=120
REFRESH_IP_WINDOW_MINUTES=15

# Proxies propios (API central, balanceador): IPs exactas o rangos CIDR, lista JSON.
# Solo desde ellos se confía en X-Forwarded-For, X-Trace-Id y X-Parent-Operation-Id.
# Vacío = conexión directa. Ejemplos:
#   ["127.0.0.1"]        central en la misma máquina, sin Docker (solo desarrollo)
#   ["172.30.0.0/24"]    red Docker exclusiva de la central y auth (ver services/apigateway/readme.md)
TRUSTED_PROXIES=[]

# Máximo de API keys activas y vigentes por usuario (entre todas sus empresas).
API_KEYS_MAX=5

# Bootstrap inicial. Habilitar solo para ejecutar POST /seed y volver a false.
SEED_ENABLED=false
# Obligatorios si SEED_ENABLED=true.
# Token que se envía en el header X-Seed-Token. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SEED_TOKEN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
