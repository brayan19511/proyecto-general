# Variables DEL COMPOSE (no de los contenedores). Copiar a .env (ignorado por git).

# Registro de imágenes (Docker Hub: el usuario) y versión de cada una
# (nunca "latest": así se puede volver atrás). Deben existir en el registro.
REGISTRY=brayan1951
AUTH_VERSION=0.1.0
APIGATEWAY_VERSION=0.1.0
LIBRO_MAYOR_VERSION=0.1.2
NOTIFICACIONES_VERSION=0.1.1
PAGOS_PROVEEDORES_VERSION=0.1.1
FRONT_VERSION=0.1.2
EDGE_VERSION=0.1.1

# Dominio con que se entra (registro A hacia este servidor) y modo de certificado:
# dns = Let's Encrypt por DNS (env/edge.env); internal = CA propia (solo pruebas).
SITE_ADDRESS=plataforma.empresa.com
CADDY_TLS=dns
# Dónde escucha caddy: 0.0.0.0 = todas las interfaces del servidor.
EDGE_BIND=0.0.0.0

# Base del contenedor "db" (si se usa una gestionada, quitar el servicio db).
# Deben coincidir con DB_NAME/DB_USER/DB_PASSWORD de env/*.env.
# DB_PASSWORD: obligatoria y fuerte; la base no arranca sin ella.
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=

# Perfiles opcionales que se levantan con "docker compose up -d" (variable propia
# de Docker Compose). admin = pgAdmin en el puerto 8443 de caddy. Vacío = no se
# levanta. Activarlo solo cuando se use y cerrar el 8443 en el firewall si no.
COMPOSE_PROFILES=
