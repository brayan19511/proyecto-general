# Variables del contenedor de la central. Copiar a apigateway.env (ignorado por git).
# Solo lo propio de producción; el resto toma su default (ver services/apigateway/.env.template).
# DB_HOST, DB_PORT, AUTH_URL, LIBRO_MAYOR_URL y TRUSTED_PROXIES los fija el compose (DB_HOST por defecto postgres.data).

SERVICE_VERSION=0.1.0
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=

# Mismo origen que el front (caddy): no hace falta CORS.
CORS_ORIGINS=[]

AUTH_ENABLED=true
LIBRO_MAYOR_ENABLED=true
IP_BLOCKS_ENABLED=true
