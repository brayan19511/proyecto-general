# Variables del contenedor de pagos-proveedores. Copiar a pagos-proveedores.env.
# Solo lo propio de producción; el resto toma su default (ver services/pagos-proveedores/.env.example).
# DB_HOST, DB_PORT, AUTH_URL, NOTIFICACIONES_URL y TRUSTED_PROXIES los fija el compose.

SERVICE_VERSION=0.1.0
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=
CORS_ORIGINS=[]

# Plantilla de los avisos si la empresa no eligió otra (Tesorería › Plantilla por defecto).
DEFAULT_TEMPLATE_CODE=payment_provider_summary
