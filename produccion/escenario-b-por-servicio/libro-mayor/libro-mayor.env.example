# Variables del contenedor de libro-mayor (API y worker). Copiar a libro-mayor.env.
# Solo lo propio de producción; el resto toma su default (ver services/libro-mayor/.env.example).
# DB_HOST, DB_PORT, AUTH_URL y TRUSTED_PROXIES los fija el compose (DB_HOST por defecto postgres.data).

SERVICE_VERSION=0.1.0
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=
CORS_ORIGINS=[]

# SAP HANA, solo lectura (usuario con SELECT sobre las vistas y nada más).
SAP_HOST=
SAP_PORT=30015
SAP_USER=
SAP_PASSWORD=
SAP_ENCRYPT=true
SAP_VALIDATE_CERTIFICATE=true

# Horario de la sincronización programada (zona America/Lima).
SYNC_SCHEDULE=06:00,10:00,14:00,18:00

SEED_ENABLED=false
