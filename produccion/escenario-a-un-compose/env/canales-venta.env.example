# Variables del contenedor de canales-venta (lastmiller). Copiar a canales-venta.env.
# Solo lo propio de producción; el resto toma su default (ver services/canales-venta/.env.example).
# DB_HOST, DB_PORT, AUTH_URL y TRUSTED_PROXIES los fija el compose.

SERVICE_VERSION=0.1.0
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=
CORS_ORIGINS=[]

# Código en auth de la única empresa dueña de lastmiller (las tablas de Ofisis
# no distinguen empresas). Vacío = lastmiller deshabilitado.
LASTMILLER_COMPANY_CODE=RASH

# Ofisis (SQL Server externo, base EcommDB). Sin pool: cada operación abre y
# cierra su conexión. El servidor debe ser alcanzable desde este host (ofisis-egress).
OFISIS_HOST=
OFISIS_PORT=1433
OFISIS_USER=
OFISIS_PASSWORD=
OFISIS_DATABASE=EcommDB
OFISIS_DRIVER=ODBC Driver 18 for SQL Server
# Cifrado activo; sin validar el certificado del servidor (autofirmado, decisión del usuario).
OFISIS_ENCRYPT=true
OFISIS_TRUST_SERVER_CERTIFICATE=true
# Límites para no quedar esperando a Ofisis: login (s), consulta (s), bloqueos (ms).
OFISIS_CONNECT_TIMEOUT_SECONDS=10
OFISIS_QUERY_TIMEOUT_SECONDS=30
OFISIS_LOCK_TIMEOUT_MS=5000
# Filas por transacción en las cargas masivas (bloqueos cortos).
LASTMILLER_WRITE_BATCH_SIZE=200
