# Variables del contenedor de notificaciones (API y worker). Copiar a notificaciones.env.
# Solo lo propio de producción; el resto toma su default (ver services/notificaciones/.env.example).
# DB_HOST, DB_PORT, AUTH_URL y TRUSTED_PROXIES los fija el compose.

SERVICE_VERSION=0.1.0
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=
CORS_ORIGINS=[]

# Claves Fernet que cifran las contraseñas SMTP (lista JSON; la primera cifra,
# todas descifran: así se rotan). Secreto: si se pierden, hay que volver a
# escribir las contraseñas de las cuentas.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEYS=[]

# Destinos SMTP permitidos (protección contra SSRF). Vacío = puertos 25/465/587/2525
# y solo direcciones públicas. Un relay interno: ["192.168.30.199/32"].
SMTP_ALLOWED_PORTS=
SMTP_ALLOWED_PRIVATE_NETWORKS=[]
SMTP_CA_BUNDLE=
SMTP_TLS_UNVERIFIED_HOSTS=[]

SEED_ENABLED=false
