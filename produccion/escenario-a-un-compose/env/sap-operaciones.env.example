# Variables del contenedor de sap-operaciones (API y worker). Copiar a sap-operaciones.env.
# Solo lo propio de producción; el resto toma su default (ver services/sap-operaciones/.env.example).
# DB_HOST, DB_PORT, AUTH_URL y TRUSTED_PROXIES los fija el compose.

SERVICE_VERSION=0.1.0
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=
CORS_ORIGINS=[]

# Service Layer por defecto (cada empresa puede tener la suya en SAP › Configuración,
# la cambia solo el administrador de plataforma).
SAP_SERVICE_LAYER_URL=https://10.0.0.14:50000/b1s/v1
# Certificado autofirmado: cifrado sin validar el certificado (decisión del usuario).
# Alternativa: SAP_VERIFY_TLS=true y la CA en SAP_CA_FILE (montada en el contenedor).
SAP_VERIFY_TLS=false
SAP_CONNECT_TIMEOUT_SECONDS=10
SAP_REQUEST_TIMEOUT_SECONDS=120

# Claves Fernet que cifran las claves SAP guardadas en los trabajos (lista JSON;
# la primera cifra, todas descifran). Secreto: si se pierden, las credenciales
# guardadas quedan ilegibles (hay que volver a ingresarlas al reanudar).
# docker run --rm <REGISTRY>/sap-operaciones:<versión> python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEYS=[]

# Fechas de las descargas CSV (se guardan en UTC). Perú = -5, sin horario de verano.
EXPORT_UTC_OFFSET_HOURS=-5
JOB_MAX_ITEMS=50000
WORKER_POLL_SECONDS=5
WORKER_LOCK_SECONDS=300
