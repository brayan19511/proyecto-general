# Variables del contenedor de auth. Copiar a auth.env (ignorado por git).
# Solo lo propio de producción; el resto toma su default (ver services/auth/.env.example).
# DB_HOST, DB_PORT y TRUSTED_PROXIES los fija el compose (dependen de las redes).

SERVICE_VERSION=0.1.0
DB_NAME=plataforma
DB_USER=plataforma
DB_PASSWORD=

# Front y API en el mismo origen (caddy): no hace falta CORS.
CORS_ORIGINS=[]

# Llaves JWT en secrets/auth/ (montado de solo lectura). Generar una vez con
# python scripts/generate_jwt_keys.py y guardarlas fuera de git, con respaldo.
JWT_ISSUER=auth
JWT_AUDIENCE=platform

# Bootstrap: solo para el primer POST /auth/seed; después volver a false.
SEED_ENABLED=false
SEED_TOKEN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
